{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/llm-usage/stats.schema.json",
  "title": "ADE Usage Stats",
  "description": "ADE 每日用量组件的数据契约（单一事实源）。aggregate.py 产出、render.py 与 UsageWidget.tsx 共同消费。字段名以本文件为准。",
  "type": "object",
  "required": ["latest_date", "total_dates", "daily"],
  "properties": {
    "latest_date": {
      "type": ["string", "null"],
      "description": "最近一天，格式 YYYY-MM-DD；无数据时 null。"
    },
    "total_dates": {
      "type": "integer",
      "minimum": 0,
      "description": "覆盖的天数。"
    },
    "daily": {
      "type": "array",
      "description": "按 (source, model, date) 聚合后的日记录。",
      "items": {
        "type": "object",
        "required": [
          "source",
          "model",
          "date",
          "requests",
          "input_tokens",
          "output_tokens",
          "total_tokens"
        ],
        "properties": {
          "source": { "type": "string", "description": "来源 / ADE，如 openai / cursor / workbuddy。" },
          "model":  { "type": "string", "description": "模型名，如 gpt-4o / hy3。" },
          "date":   { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "requests":      { "type": "integer", "minimum": 0 },
          "input_tokens":  { "type": "integer", "minimum": 0 },
          "output_tokens": { "type": "integer", "minimum": 0 },
          "total_tokens":  { "type": "integer", "minimum": 0, "description": "input + output，由 aggregate 计算。" }
        }
      }
    }
  }
}
